                  "etag": "8GNfC6hnOKzo2qaoIxMW/g==",
                  "id": "thelook-analytics-509323:US.f8a8fbf0-9f56-4ba4-a6d5-7ea183125b00",
                  "selfLink": "https://bigquery.googleapis.com/bigquery/v2/projects/thelook-analytics-509323/jobs/f8a8fbf0-9f56-4ba4-a6d5-7ea183125b00?location=US",
                  "user_email": "marcgnancadja4@gmail.com",
                  "configuration": {
                    "query": {
                      "query": "-- =============================================================================\n-- TASK 3 : PRIMARY KEY UNIQUENESS AND NOT_NULL CHECK?\n-- Metadata only: this query scans no table data.\n-- =============================================================================\n\nWITH PK_CHECK AS (\n\tSELECT 'users.id' as key_name , CAST(id AS STRING) AS key_value \tFROM `bigquery-public-data.thelook_ecommerce.users`\n\tUNION ALL\n\tSELECT 'orders.order_id' ,      CAST(order_id AS STRING)     \t\tFROM `bigquery-public-data.thelook_ecommerce.orders`\n\tUNION ALL\n\tSELECT 'order_items.id' ,      CAST(id AS STRING)     \t\tFROM `bigquery-public-data.thelook_ecommerce.order_items`\n\tUNION ALL\n\tSELECT 'products.id' ,      CAST(id AS STRING)     \t\tFROM `bigquery-public-data.thelook_ecommerce.products`\n\tUNION ALL\n\tSELECT 'inventory_items.id' ,      CAST(id AS STRING)     \t\tFROM `bigquery-public-data.thelook_ecommerce.inventory_items`\n\tUNION ALL\n\tSELECT 'distribution_centers.id' ,      CAST(id AS STRING)     \t\tFROM `bigquery-public-data.thelook_ecommerce.distribution_centers`\n\t\n)\n\nSELECT \n\tkey_name,\n\tCOUNT(*) AS  TOTAL_ROWS, \n\tCOUNT(DISTINCT key_value) DISTINCT_VALUE,\n\tCOUNTIF(key_value IS NULL) as TOTAL_NULL,\n\tCOUNT(*) - COUNT(DISTINCT key_value)      AS DUPLICATED_ROWS\nFROM PK_CHECK \nGROUP BY key_name\nORDER BY key_name",
