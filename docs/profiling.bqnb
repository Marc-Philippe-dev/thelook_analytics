    {
      "kind": 2,
      "languageId": "bqsql",
      "value": "-- 6d. Status versus dates: a \"Complete\" line should have a delivery date\nSELECT\n    status,\n    COUNTIF(shipped_at   IS NULL) AS missing_shipped_at,\n    COUNTIF(delivered_at IS NULL) AS missing_delivered_at,\n    COUNTIF(returned_at  IS NOT NULL) AS has_returned_at,\n    COUNT(*) AS _rows\nFROM `bigquery-public-data.thelook_ecommerce.order_items`\nGROUP BY status\nORDER BY _rows DESC;\n",
      "outputs": [
        {
          "items": [
